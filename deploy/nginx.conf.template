# Replace DOMAIN with the configured DNS name. Never expose the blob directory.
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;
    access_log off;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 308 https://DOMAIN:9443$request_uri; }
}
server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # Capabilities can occur in paths; don't persist URLs in access/error logs.
    access_log off;
    error_log /var/log/nginx/nimbus-error.log crit;
    client_max_body_size 55m;
    client_body_timeout 120s;
    location ^~ /media/ { return 404; }
    location = / { return 302 /vault/; }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host DOMAIN:9443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_buffering off;
    }
}
