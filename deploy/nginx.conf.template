# DOMAIN=cloud.nimbus.by, LEGACY_DOMAIN=nimbus.by. See docs/DEPLOYMENT.md.
# External ingress forwards TLS to loopback; Nimbus never owns ports 80/443.
# The certificate must cover both names. See docs/DEPLOYMENT.md.
server {
    # Compatible with CI's Nginx 1.24; equivalent to `http2 on` on newer Nginx.
    listen 127.0.0.1:9443 ssl http2;
    server_name DOMAIN LEGACY_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/nimbus-error.log crit;
    client_max_body_size 55m;
    client_body_timeout 120s;
    if ($host != DOMAIN) { return 308 https://DOMAIN$request_uri; }
    # Relative application redirects preserve the public origin without a port.
    absolute_redirect off;
    location ^~ /media/ { return 404; }
    location = / { return 302 /vault/; }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_buffering off;
    }
}
