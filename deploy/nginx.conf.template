# DOMAIN=cloud.nimbus.by, LEGACY_DOMAIN=nimbus.by. See docs/DEPLOYMENT.md.
# Nginx owns only 9443. The certificate must cover both names.
server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name DOMAIN LEGACY_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/nimbus-error.log crit;
    client_max_body_size 55m;
    client_body_timeout 120s;
    if ($http_host != DOMAIN:9443) { return 308 https://DOMAIN:9443$request_uri; }
    # Relative application redirects preserve the public :9443 origin.
    absolute_redirect off;
    location ^~ /media/ { return 404; }
    location = / { return 302 /vault/; }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host DOMAIN:9443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_buffering off;
    }
}
