DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEFAULT_FROM_EMAIL=cloud.nimbus <noreply@example.com>
MAX_SINGLE_UPLOAD_BYTES=52428800
UPLOAD_CHUNK_BYTES=5242880
MALWARE_SCAN_REQUIRED=0
CLAMSCAN_PATH=clamscan
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_SECONDS=900
TELEGRAM_VERIFIED_QUOTA_BYTES=52428800
# STORAGE_BACKEND=local
# STORAGE_GATEWAY_URL=http://127.0.0.1:8090
# STORAGE_GATEWAY_SECRET=replace-me
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# E2EE defaults. Export variables in the process environment; .env is not auto-loaded.
TELEGRAM_ENABLED=0
NIMBUS_LEGACY_WRITES_ENABLED=0
OPAQUE_ENABLED=1
OPAQUE_NODE=node
# Generate once with: python manage.py generate_opaque_setup --output /secure/path/opaque-setup
# Then supply its contents through your secret manager as OPAQUE_SERVER_SETUP.
OPAQUE_SERVER_SETUP=
LOGIN_SECOND_FACTOR_REQUIRED=1
PASSKEY_REQUIRED=1
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8017
# For production set DEBUG=0, configure HTTPS origin/RP ID, secret key and SMTP.
